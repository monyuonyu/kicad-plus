#!/bin/bash
# 改良した KiCad の pcbnew モジュールで Python を動かす(SWIG の所有権の不具合も直してある)
# このリポジトリの場所(道具と試験を探す)と、修正版 KiCad をビルドした場所
KICAD_LOCAL_HOME=${KICAD_LOCAL_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
# 配布版は同梱の build/、ソースから作ったときは ~/src/build-10.0.6
[ -z "$KICAD_LOCAL_BUILD" ] && [ -d "$KICAD_LOCAL_HOME/build" ] && KICAD_LOCAL_BUILD=$KICAD_LOCAL_HOME/build
KICAD_LOCAL_BUILD=${KICAD_LOCAL_BUILD:-$HOME/src/build-10.0.6}
export KICAD_LOCAL_HOME KICAD_LOCAL_BUILD
# 文字コードが UTF-8 でない環境（LANG が無い docker など）では、日本語の文字列を扱うところで落ちる（kicad_route ほか）ので UTF-8 に
case "$(locale charmap 2>/dev/null)" in UTF-8) ;; *) export LC_ALL=C.UTF-8 ;; esac
# 改良版のビルドが無ければ本家の pcbnew（/usr/lib/python3/dist-packages）を使う
if ls "$KICAD_LOCAL_BUILD"/pcbnew/_pcbnew*.so >/dev/null 2>&1; then
  PYTHONPATH="$KICAD_LOCAL_BUILD/pcbnew${PYTHONPATH:+:$PYTHONPATH}" exec python3 "$@"
fi
export KICAD_LOCAL_MODE=system
exec python3 "$@"
