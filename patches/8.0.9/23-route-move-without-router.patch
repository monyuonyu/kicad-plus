USB-C の受け口（USB4105）は自分のパッドと取り付け穴が近く、押しのけルーターの部品の移動（place・drag）が
線の無いときでも失敗していた。つながる線が無く、findspace と同じ確かめ（外形枠・銅箔のクリアランス・基板の内側）
を通れば、ルーターを通さずに動かす（注意を出す）。
---
 qa/tools/pns/kicad_route_main.cpp | 51 +++++++++++++++++++++++++++++--
 1 file changed, 48 insertions(+), 3 deletions(-)

diff --git a/qa/tools/pns/kicad_route_main.cpp b/qa/tools/pns/kicad_route_main.cpp
index c031e39..717b297 100644
--- a/qa/tools/pns/kicad_route_main.cpp
+++ b/qa/tools/pns/kicad_route_main.cpp
@@ -1121,6 +1121,11 @@ static std::set<FOOTPRINT*> overlappedRefs( CTX& c )
 }
 
 
+// ルーターで動かせない部品(自分のパッドどうしが近すぎる USB-C の受け口など)を、つながる線が無く、置き先が
+// 空いているときだけ、そのまま動かす(定義は fitsAt の後)
+static bool moveDirectly( CTX& c, FOOTPRINT* aFp, const VECTOR2I& aDelta, wxString* aWhy );
+
+
 static bool doDrag( CTX& c, const wxString& aRef, const VECTOR2I& aDelta )
 {
     FOOTPRINT* fp = findFp( c.board, aRef );
@@ -1170,12 +1175,24 @@ static bool doDrag( CTX& c, const wxString& aRef, const VECTOR2I& aDelta )
 
     if( !c.router->FixRoute( p0 + aDelta, nullptr, false, false ) )
     {
-        msg( "  %d行: NG %s を動かせない(つながった線を迂回・押しのけで引き直せない)\n", aRef );
         c.router->StopRouting();
-        return false;
+        wxString why;
+
+        if( !moveDirectly( c, fp, aDelta, &why ) )
+        {
+            msg( "  %d行: NG %s\n", aRef + wxS( " を動かせない(つながった線を迂回・押しのけで引き直せない" )
+                                     + ( why.IsEmpty() ? wxString( wxS( "" ) ) : wxS( "。" ) + why ) + wxS( ")" ) );
+            return false;
+        }
+
+        msg( "  %d行: 注意 %s\n", aRef + wxS( " はルーターでは動かせなかった。つながる線が無く置き先も空いているので、"
+                                             "そのまま動かした" ) );
+    }
+    else
+    {
+        c.router->StopRouting();
     }
 
-    c.router->StopRouting();
     fp->BuildCourtyardCaches();
     c.dirty = true;
 
@@ -1361,6 +1378,34 @@ static bool fitsAt( CTX& c, FOOTPRINT* aFp, FP_AT_ROT& aShapes, const VECTOR2I&
 }
 
 
+static bool moveDirectly( CTX& c, FOOTPRINT* aFp, const VECTOR2I& aDelta, wxString* aWhy )
+{
+    for( PCB_TRACK* t : c.board->Tracks() )
+    {
+        for( PAD* pad : aFp->Pads() )
+        {
+            if( pad->GetNetCode() > 0 && t->GetNetCode() == pad->GetNetCode()
+                && ( pad->HitTest( t->GetStart() ) || pad->HitTest( t->GetEnd() ) ) )
+            {
+                if( aWhy ) *aWhy = wxS( "つながる線がある" );
+                return false;
+            }
+        }
+    }
+
+    BOX2I edge = c.board->GetBoardEdgesBoundingBox();
+    edge.Inflate( -pcbIUScale.mmToIU( 0.3 ) );
+    FP_AT_ROT shapes = shapesAtRotation( aFp, aFp->GetOrientation() );
+    std::vector<OBST> obs = collectObstacles( c.board, aFp );
+
+    if( !fitsAt( c, aFp, shapes, aFp->GetPosition() + aDelta, obs, clearanceOf( c.board ), edge, aWhy ) )
+        return false;
+
+    aFp->Move( aDelta );
+    return true;
+}
+
+
